{
  "manifest_version": 3,
  "name": "Babelo — связь браузера с программой",
  "version": "0.2.0",
  "description": "Соединяет программу Babelo с видео в браузере: субтитры вперёд и точная перемотка. Меню и настройки — в программе (F10).",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:47831/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Babelo",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}